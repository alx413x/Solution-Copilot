# Local development only; copy to .env. Never use these credentials in deployment.
POSTGRES_DB=solution_copilot
POSTGRES_USER=solution
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://solution:local-development-only@127.0.0.1:5432/solution_copilot
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=local-solution
S3_SECRET_KEY=local-development-only
S3_BUCKET=solution-copilot
S3_REGION=us-east-1
# Web server reads API_BASE_URL from its process environment; default below.
API_BASE_URL=http://127.0.0.1:8000
# Reserved for S03/S04; no model calls in S00.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
# Explicitly opt in for local demo; production rejects this flag.
APP_ENV=development
DEV_AUTH_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
WEB_ORIGIN=http://127.0.0.1:3000
UPLOAD_MAX_BYTES=26214400
DOCUMENT_MAX_CHARS=2000000
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
